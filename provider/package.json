{
  "name": "medplum-provider",
  "version": "5.1.39",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:bot": "esbuild bots/consistency.ts --bundle --platform=node --target=node22 --format=esm --external:@medplum/core --external:@medplum/fhirtypes --outfile=bot-dist/consistency-bot.mjs",
    "test:bot-bundle": "npm run build:bot && node --test bots/bundle-smoke.mjs",
    "deploy:bot": "node -e \"require('fs').existsSync('medplum.config.json') || (console.error('No medplum.config.json. Run: npm --prefix provider run setup'), process.exit(1))\" && npm run test:bot-bundle && medplum bot deploy healthcare-consistency",
    "setup": "node scripts/setup-medplum.ts",
    "configure": "node scripts/configure-provider.ts",
    "test:e2e": "playwright test",
    "measure": "node scripts/measure-jev.ts"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@mantine/spotlight": "8.3.18",
    "@medplum/cli": "5.1.39",
    "@medplum/core": "5.1.39",
    "@medplum/definitions": "5.1.39",
    "@medplum/dosespot-react": "5.1.39",
    "@medplum/scriptsure-react": "5.1.39",
    "@medplum/eslint-config": "5.1.39",
    "@medplum/fhirtypes": "5.1.39",
    "@medplum/health-gorilla-core": "5.1.39",
    "@medplum/health-gorilla-react": "5.1.39",
    "@medplum/mock": "5.1.39",
    "@medplum/react": "5.1.39",
    "@medplum/react-scheduling": "5.1.39",
    "@playwright/test": "1.63.0",
    "@tabler/icons-react": "3.46.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "driver.js": "1.8.0",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "prettier-plugin-organize-imports": "4.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-live": "4.1.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  }
}
